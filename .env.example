# ─── NextAuth ────────────────────────────────────────────────
# Generate a strong secret: openssl rand -base64 32
NEXTAUTH_SECRET=your-secret-here
NEXTAUTH_URL=https://your-domain.vercel.app

# ─── Google Sheets IDs ───────────────────────────────────────
# Copy the ID from the spreadsheet URL:
# https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SHEETS_SESSIONS_ID=your-sessions-spreadsheet-id
SHEETS_TRIALS_ID=your-trials-spreadsheet-id
SHEETS_NP_ID=your-new-payments-spreadsheet-id
SHEETS_NS_ID=your-new-sellers-spreadsheet-id

# ─── Google Service Account ──────────────────────────────────
# Paste the entire service account JSON key as a single line (minified)
GOOGLE_SERVICE_ACCOUNT_JSON={"type":"service_account","project_id":"..."}

# ─── Users ───────────────────────────────────────────────────
# JSON array with affiliate credentials.
# Generate password hashes with: npm run hash-password
# Example:
# [{"username":"partner-code","password_hash":"$2b$10$...","partner_code":"partner-code","name":"Nome do Afiliado"}]
USERS_JSON=[{"username":"example","password_hash":"$2b$10$example","partner_code":"example","name":"Afiliado Exemplo"}]
